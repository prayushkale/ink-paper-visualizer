# Server-side only. Never shipped to the browser.
# This file wins: the server loads it with `override: true`, so an `export
# FAL_KEY=...` sitting in your shell rc cannot shadow it.

# fal.ai key - powers the H3 Max Director realtime session, the Multi Angle
# queue endpoint, and fal storage uploads used to host blot + music files.
FAL_KEY=...

# OpenRouter key - the vision model that imagines what each blot could be.
# Default model: deepseek/deepseek-v4.1-flash (change it in the app's Settings).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Proxy port / bind address. The proxy holds your fal key, so it
# binds to loopback by default; change HOST only if you know why.
PORT=8787
HOST=127.0.0.1

# Optional. When set, the browser must send this value as the `x-ink-token`
# header (set it in the app's Settings panel too). Leave blank for local-only use.
PROXY_AUTH_TOKEN=
