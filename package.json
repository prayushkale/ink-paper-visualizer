{
  "name": "ink-paper-visualizer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "test": "vitest run && node --test 'server/**/*.test.mjs'",
    "test:client": "vitest run",
    "test:server": "node --test server/",
    "build": "vite build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/three": "^0.168.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
