{
  "name": "ink-paper-visualizer",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-dev-deps.mjs",
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "pretest": "node scripts/check-dev-deps.mjs",
    "test": "vitest run && node --test server/index.test.mjs",
    "test:client": "vitest run",
    "test:server": "node --test server/index.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@fal-ai/client": "1.11.0-alpha.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/three": "^0.168.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
